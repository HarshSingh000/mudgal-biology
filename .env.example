PORT=3000
NODE_ENV=development
SQLITE_PATH=./data/mudgal_biology.db
CORS_ORIGIN=

# Security (required 32+ char unique secrets in production)
JWT_SECRET=REPLACE_WITH_MIN_32_CHAR_PRODUCTION_SECRET
WEBHOOK_SECRET=REPLACE_WITH_RAZORPAY_WEBHOOK_SECRET
MEDIA_SIGNING_SECRET=REPLACE_WITH_MEDIA_SIGNING_SECRET
ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD_FOR_9999999999
SUPER_ADMIN_PASSWORD=REPLACE_WITH_SUPER_ADMIN_PASSWORD_FOR_8888888888

# SMS OTP (none | msg91 | fast2sms | twilio)
SMS_PROVIDER=none
OTP_COOLDOWN_SECONDS=30
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=MUDGAL
FAST2SMS_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Live Razorpay Checkout & Webhooks
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
